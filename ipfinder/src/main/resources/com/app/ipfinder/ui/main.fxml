<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.app.ipfinder.ui.controller.MainController">

        <left>

                <VBox
                        prefWidth="220"
                        spacing="10"
                        styleClass="sidebar">

                        <Label
                                text="IP Finder"
                                styleClass="app-title" />

                        <VBox
                                spacing="6"
                                VBox.vgrow="ALWAYS">

                                <Button
                                        fx:id="lookupButton"
                                        text="⌕  Lookup"
                                        onAction="#showLookup"
                                        styleClass="nav-button" />

                                <Button
                                        fx:id="historyButton"
                                        text="◷  History"
                                        onAction="#showHistory"
                                        styleClass="nav-button" />


                        </VBox>
                        <Button fx:id="themeButton"
                                text="☾  Dark Mode"
                                onAction="#toggleTheme"
                                styleClass="nav-button" />

                        <Label
                                fx:id="statusLabel"
                                styleClass="sidebar-status" />

                </VBox>

        </left>

        <center>

                <StackPane
                        fx:id="contentPane"
                        styleClass="content-area" />

        </center>

</BorderPane>