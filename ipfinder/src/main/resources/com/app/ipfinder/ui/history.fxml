<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.app.ipfinder.ui.controller.HistoryController"
        styleClass="page">

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="10">

            <VBox
                    spacing="4"
                    HBox.hgrow="ALWAYS">

                <Label
                        text="Lookup History"
                        styleClass="page-title"/>

                <Label
                        text="View your previous IP address lookups."
                        styleClass="page-subtitle"/>

            </VBox>

            <Button
                    text="↻  Refresh"
                    onAction="#refresh"
                    styleClass="secondary-button"/>

            <Button
                    text="Clear History"
                    onAction="#clearHistory"
                    styleClass="danger-button"/>

        </HBox>

    </top>

    <center>

        <TableView
                fx:id="historyTable"
                styleClass="history-table">

            <columns>

                <TableColumn
                        fx:id="ipColumn"
                        text="IP Address"
                        prefWidth="180"/>

                <TableColumn
                        fx:id="countryColumn"
                        text="Country"
                        prefWidth="150"/>

                <TableColumn
                        fx:id="cityColumn"
                        text="City"
                        prefWidth="150"/>

                <TableColumn
                        fx:id="ispColumn"
                        text="ISP"
                        prefWidth="220"/>

                <TableColumn
                        fx:id="timestampColumn"
                        text="Timestamp"
                        prefWidth="180"/>

            </columns>

        </TableView>

    </center>

</BorderPane>